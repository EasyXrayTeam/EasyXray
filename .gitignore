# Ignore editor and IDE settings
.idea/
.vscode/
.cursor/
.specify/
.claude/
.cache/
.sync*

# Ignore log files
*.log

# Ignore temporary files
tmp/
*.tar.gz

# Ignore build and distribution directories
backup/
bin/
easyxray/
**/dist/*
# The panel embeds internal/web/dist with go:embed all:dist. The build output is
# generated, but its directory has to exist for a bare `go build` to compile.
!internal/web/dist/.gitkeep
release/
node_modules/

# Ignore compiled binaries
main
EasyXray

# Ignore OS specific files
.DS_Store
Thumbs.db

# Ignore Go build files
*.exe
EasyXray.db
EasyXray.db-shm
EasyXray.db-wal
system_metrics.gob
*.dump

# Ignore Docker specific files
docker-compose.override.yml

# Ignore .env (Environment Variables) file
.env
