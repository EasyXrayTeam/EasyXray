#!/sbin/openrc-run

command="/usr/local/easyxray/easyxray"
command_background=true
pidfile="/run/easyxray.pid"
description="easyxray Service"
procname="easyxray"
depend() {
    need net
}
start_pre(){
    cd /usr/local/easyxray
}
reload() {
  ebegin "Reloading ${RC_SVCNAME}"
  kill -USR1 $(cat $pidfile)
  eend $?
}